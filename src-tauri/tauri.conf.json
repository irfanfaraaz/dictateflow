{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DictateFlow",
  "version": "0.2.0",
  "identifier": "com.dictateflow.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "DictateFlow",
        "url": "index.html",
        "width": 720,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0d0c0a"
      },
      {
        "label": "pill",
        "title": "dictateflow-pill",
        "url": "pill.html",
        "width": 160,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "resources": ["resources/*"]
  }
}
